pbdata:
      owl:versionInfo """1.0, created by Aldo Gangemi on February 16th, 2017"""^^xsd:string ;
      rdfs:comment """A simple linked data design for the PropBank role sets (verbal frames) roles, role types."""^^xsd:string ;
 	  rdf:type owl:Ontology .

